{
  "name": "finovaiq",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "typecheck": "turbo typecheck",
    "lint": "eslint .",
    "test": "turbo test",
    "test:e2e": "playwright test",
    "db:local": "node scripts/local-db.mjs",
    "db:generate": "pnpm --filter @finovaiq/api exec prisma generate",
    "db:migrate": "pnpm --filter @finovaiq/api exec prisma migrate deploy",
    "db:seed": "pnpm --filter @finovaiq/api seed"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.58.0",
    "embedded-postgres": "17.9.0-beta.17",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0"
  }
}
